#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
FLUTTER_BIN="${ROOT_DIR}/.tooling/flutter/bin/flutter"

if [[ ! -x "${FLUTTER_BIN}" ]]; then
  echo "Flutter 未安装或未解压到 .tooling/flutter"
  echo "请先下载并解压 Flutter SDK 到: ${ROOT_DIR}/.tooling/flutter"
  exit 1
fi

exec "${FLUTTER_BIN}" "$@"
